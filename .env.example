# Neon PostgreSQL connection strings.
#
# DATABASE_URL — the POOLED endpoint (the host contains "-pooler"). Used by the
# running application. Vercel executes API routes as serverless functions and
# each invocation can open its own connection, so queries go through the pooler
# to avoid exhausting the connection limit.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/chowly?sslmode=require"

# DIRECT_URL — the DIRECT endpoint (no "-pooler"). Used for migrations, which
# cannot run through the pooler.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/chowly?sslmode=require"
